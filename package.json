{
  "name": "cabugi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile",
    "runtime:up": "./infra/scripts/up_full_stack.sh",
    "test:web": "pnpm --filter web test --run",
    "typecheck:web": "pnpm --filter web typecheck",
    "test:api": "cd services/api && go test ./...",
    "test:judge": "cd services/judge && go test ./...",
    "verify:db": "./db/scripts/verify_initial_schema.sh",
    "verify:db-ops": "./db/scripts/verify_migration_workflow.sh",
    "verify:integration": "./infra/scripts/verify_platform_integration.sh",
    "verify:runtime": "./infra/scripts/verify_runtime_packaging.sh",
    "verify:smoke:api": "./infra/scripts/verify_api_runtime_smoke.sh",
    "verify:smoke:e2e": "./infra/scripts/verify_e2e_workflow_smoke.sh",
    "verify:security": "./infra/scripts/verify_go_vulnerabilities.sh",
    "db:migrate": "./db/scripts/migrate.sh up",
    "db:migration-status": "./db/scripts/migrate.sh status",
    "db:backup": "./db/scripts/backup.sh",
    "db:restore": "./db/scripts/restore.sh",
    "build:image:web": "docker build -t cabugi-web -f apps/web/Dockerfile .",
    "build:image:api": "docker build -t cabugi-api -f services/api/Dockerfile services/api",
    "build:image:judge": "docker build -t cabugi-judge -f services/judge/Dockerfile services/judge"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
